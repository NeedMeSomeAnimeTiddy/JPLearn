From: JPLearn
Subject: [PATCH] tts-server: add --speaker-bank preset voice cloning

Upstream commit this patch applies to:
  ServeurpersoCom/qwentts.cpp @ 9dbe7ea26a01b30fccb117ae5e86807c1dc23d42

Why:
  The shipped tts-server.cpp OpenAI-compatible HTTP adapter only routes
  the "voice" field to named CustomVoice speakers (qt_tts_params.speaker)
  or a VoiceDesign instruction. It never wires the Base-mode reference
  clip cloning fields (ref_spk_emb / ref_codes / ref_text) that
  qt_tts_params already supports and that qwen-tts.cpp (the CLI) already
  exposes via --ref-spk / --ref-rvq / --ref-text.

  JPLearn ships a curated bank of Japanese preset speakers built from
  user-provided reference clips (pre-encoded once via `qwen-codec
  --talker` into .spk / .rvq pairs, see data/tts/preset_bank/). The
  always-on HTTP server needs a way to preload those presets once at
  startup and serve them by name, without paying model-reload cost per
  utterance and without extending the OAI request schema.

What this patch does:
  Adds a --speaker-bank <dir> server flag. At startup, scans <dir> for
  one subfolder per preset speaker (folder name == voice name), each
  containing:
    spk.bin        required, raw f32 speaker embedding (qwen-codec --talker output)
    rvq.bin        optional, packed ICL reference codes (qwen-codec --talker output)
    ref_text.txt   optional, transcript required alongside rvq.bin for ICL mode

  Loaded presets are appended to GET /v1/voices and are preferred over
  named CustomVoice speakers when POST /v1/audio/speech's "voice" field
  matches a preset folder name; otherwise existing named-speaker /
  instruction behavior is unchanged.

Apply with (from a clean checkout of the pinned commit above):
  git apply --whitespace=nowarn patches/qwentts-cpp/0001-speaker-bank.patch

See scripts/build_qwentts_cpp.ps1 for the full clone+patch+build flow.

---
diff --git a/tools/tts-server.cpp b/tools/tts-server.cpp
index e90c8a6..fe17c2e 100644
--- a/tools/tts-server.cpp
+++ b/tools/tts-server.cpp
@@ -6,11 +6,158 @@
 #include "tts-server.h"
 
 #include "qwen.h"
+#include "rvq-file.h"
+#include "utf8.h"
 #include "version.h"
 
 #include <cstdio>
 #include <cstring>
+#include <cwchar>
 #include <string>
+#include <unordered_map>
+#include <vector>
+
+// 11 bits per code (V <= 2048), matching qwen-codec / qwen-tts.cpp.
+static const int QWENTTS_RVQ_CODE_BITS = 11;
+
+// A curated JPLearn Japanese preset speaker: a pre-encoded speaker embedding
+// (.spk) plus optional ICL reference codes (.rvq) and transcript, loaded once
+// at server startup so per-request synthesis never re-reads or re-encodes a
+// reference clip. Mirrors qwen-tts.cpp's --ref-spk / --ref-rvq / --ref-text
+// CLI loading exactly, just done up front for every folder under
+// --speaker-bank instead of once per CLI invocation.
+struct qwentts_preset_speaker {
+    std::vector<float>   spk_emb;
+    std::vector<int32_t> codes;
+    int                   ref_T = 0;
+    std::string           ref_text;
+};
+
+// Read a .spk file: raw f32 values, the count IS the embedding dimension.
+// Duplicated from qwen-tts.cpp (kept static/local, not worth a shared header
+// for one 20-line helper).
+static bool qwentts_read_spk_file(const char * path, std::vector<float> & emb) {
+    FILE * f = utf8_fopen(path, "rb");
+    if (!f) {
+        fprintf(stderr, "[Server] ERROR: cannot open speaker-bank spk file '%s'\n", path);
+        return false;
+    }
+    fseek(f, 0, SEEK_END);
+    long sz = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (sz <= 0 || (sz % (long) sizeof(float)) != 0) {
+        fprintf(stderr, "[Server] ERROR: speaker-bank spk file '%s' size %ld is not a positive multiple of 4\n", path,
+                sz);
+        fclose(f);
+        return false;
+    }
+    emb.resize((size_t) sz / sizeof(float));
+    if (fread(emb.data(), sizeof(float), emb.size(), f) != emb.size()) {
+        fprintf(stderr, "[Server] ERROR: short read on speaker-bank spk file '%s'\n", path);
+        fclose(f);
+        return false;
+    }
+    fclose(f);
+    return true;
+}
+
+static bool qwentts_read_text_file(const char * path, std::string & out) {
+    FILE * f = utf8_fopen(path, "rb");
+    if (!f) {
+        fprintf(stderr, "[Server] ERROR: cannot open speaker-bank ref_text file '%s'\n", path);
+        return false;
+    }
+    fseek(f, 0, SEEK_END);
+    long sz = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    out.resize(sz > 0 ? (size_t) sz : 0);
+    if (sz > 0 && fread(&out[0], 1, (size_t) sz, f) != (size_t) sz) {
+        fclose(f);
+        fprintf(stderr, "[Server] ERROR: short read on speaker-bank ref_text file '%s'\n", path);
+        return false;
+    }
+    fclose(f);
+    while (!out.empty() && (out.back() == '\n' || out.back() == '\r')) {
+        out.pop_back();
+    }
+    return true;
+}
+
+// Scans --speaker-bank <dir> for one subfolder per preset speaker, each
+// containing spk.bin (required), and optionally rvq.bin + ref_text.txt for
+// ICL clone mode. Folder name becomes the OAI "voice" name clients pass to
+// POST /v1/audio/speech. Returns the loaded presets; logs and skips (does
+// not fail startup on) any folder missing spk.bin.
+// Narrow a wide Win32 filename back to UTF-8. Mirrors utf8_init's
+// WideCharToMultiByte usage in utf8.h; kept local since this is the only
+// wide->narrow direction this file needs (utf8.h only ships the reverse,
+// utf8_to_wide, used below for the FindFirstFileW pattern).
+#if defined(_WIN32)
+static std::string qwentts_wide_to_utf8(const wchar_t * w) {
+    int n = WideCharToMultiByte(CP_UTF8, 0, w, -1, NULL, 0, NULL, NULL);
+    if (n <= 1) {
+        return std::string();
+    }
+    std::string s((size_t) (n - 1), '\0');
+    WideCharToMultiByte(CP_UTF8, 0, w, -1, &s[0], n, NULL, NULL);
+    return s;
+}
+#endif
+
+static std::unordered_map<std::string, qwentts_preset_speaker> qwentts_load_speaker_bank(const char * dir_path,
+                                                                                         qt_context *  q) {
+    std::unordered_map<std::string, qwentts_preset_speaker> presets;
+#if defined(_WIN32)
+    std::wstring                   wpattern = utf8_to_wide(dir_path) + L"\\*";
+    WIN32_FIND_DATAW                fd;
+    HANDLE                          h = FindFirstFileW(wpattern.c_str(), &fd);
+    if (h == INVALID_HANDLE_VALUE) {
+        fprintf(stderr, "[Server] WARNING: --speaker-bank '%s' is not a readable directory\n", dir_path);
+        return presets;
+    }
+    do {
+        if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) {
+            continue;
+        }
+        if (std::wcscmp(fd.cFileName, L".") == 0 || std::wcscmp(fd.cFileName, L"..") == 0) {
+            continue;
+        }
+        std::string name = qwentts_wide_to_utf8(fd.cFileName);
+        std::string base = std::string(dir_path) + "\\" + name;
+        std::string spk_path = base + "\\spk.bin";
+        qwentts_preset_speaker preset;
+        if (!qwentts_read_spk_file(spk_path.c_str(), preset.spk_emb)) {
+            continue;
+        }
+        std::string rvq_path = base + "\\rvq.bin";
+        std::string text_path = base + "\\ref_text.txt";
+        FILE *      rvq_probe = utf8_fopen(rvq_path.c_str(), "rb");
+        if (rvq_probe) {
+            fclose(rvq_probe);
+            const int K = qt_num_codebooks(q);
+            if (rvq_read_file(rvq_path.c_str(), K, QWENTTS_RVQ_CODE_BITS, preset.codes, &preset.ref_T)
+                && qwentts_read_text_file(text_path.c_str(), preset.ref_text)) {
+                fprintf(stderr, "[Server] preset '%s': spk (%zu f32) + ICL rvq (T=%d)\n", name.c_str(),
+                        preset.spk_emb.size(), preset.ref_T);
+            } else {
+                fprintf(stderr,
+                        "[Server] preset '%s': spk only (rvq/ref_text present but unreadable, falling back to "
+                        "x-vector only mode)\n",
+                        name.c_str());
+                preset.codes.clear();
+                preset.ref_T = 0;
+            }
+        } else {
+            fprintf(stderr, "[Server] preset '%s': spk only, x-vector clone mode\n", name.c_str());
+        }
+        presets.emplace(name, std::move(preset));
+    } while (FindNextFileW(h, &fd));
+    FindClose(h);
+#else
+    fprintf(stderr, "[Server] WARNING: --speaker-bank directory scan is only implemented for Windows in this build\n");
+#endif
+    return presets;
+}
 
 static void print_usage(const char * prog) {
     fprintf(stderr, "qwentts.cpp %s\n\n", QWEN_VERSION);
@@ -24,7 +171,10 @@ static void print_usage(const char * prog) {
             "  --port <n>              Listen port (default: 8080)\n"
             "  --lang <name>           Language label (default: auto)\n"
             "  --no-fa                 Disable flash attention\n"
-            "  --clamp-fp16            Clamp hidden states to FP16 range\n",
+            "  --clamp-fp16            Clamp hidden states to FP16 range\n"
+            "  --speaker-bank <dir>    Directory of preset speaker subfolders (spk.bin, optional rvq.bin +\n"
+            "                          ref_text.txt), preloaded once and reachable by folder name via the OAI\n"
+            "                          'voice' field (Base-mode talker only)\n",
             prog);
 }
 
@@ -40,8 +190,9 @@ int main(int argc, char ** argv) {
     const char *  codec_path  = NULL;
     std::string   lang        = "auto";
     server_config cfg;
-    bool          use_fa     = true;
-    bool          clamp_fp16 = false;
+    bool          use_fa       = true;
+    bool          clamp_fp16   = false;
+    const char *  speaker_bank = NULL;
 
     for (int i = 1; i < argc; i++) {
         const char * arg = argv[i];
@@ -59,6 +210,8 @@ int main(int argc, char ** argv) {
             use_fa = false;
         } else if (!std::strcmp(arg, "--clamp-fp16")) {
             clamp_fp16 = true;
+        } else if (!std::strcmp(arg, "--speaker-bank") && i + 1 < argc) {
+            speaker_bank = argv[++i];
         } else if (!std::strcmp(arg, "--help") || !std::strcmp(arg, "-h")) {
             print_usage(argv[0]);
             return 0;
@@ -94,15 +247,40 @@ int main(int argc, char ** argv) {
         be.voices.push_back(qt_speaker_name(q, i));
     }
 
+    // Preset speakers (JPLearn curated Japanese speaker bank): preloaded once
+    // here so GET /v1/voices reports them alongside any named CustomVoice
+    // speakers, and POST /v1/audio/speech routes a matching "voice" name to
+    // ref_spk_emb/ref_codes/ref_text instead of the named-speaker path.
+    std::unordered_map<std::string, qwentts_preset_speaker> presets;
+    if (speaker_bank) {
+        presets = qwentts_load_speaker_bank(speaker_bank, q);
+        for (const auto & kv : presets) {
+            be.voices.push_back(kv.first);
+        }
+        fprintf(stderr, "[Server] loaded %zu preset speaker(s) from '%s'\n", presets.size(), speaker_bank);
+    }
+
     // The adapter always drives the streaming pipeline : on_chunk routes to
     // the shared sink, which either streams to the socket (pcm) or fills a
     // one-shot buffer (wav). Either way the audio path is identical.
-    be.synthesize = [q, &lang](const tts_request & req, const tts_sink & sink, std::string & err) -> int {
+    be.synthesize = [q, &lang, &presets](const tts_request & req, const tts_sink & sink, std::string & err) -> int {
         struct qt_tts_params p;
         qt_tts_default_params(&p);
         p.text = req.input.c_str();
         p.lang = lang.c_str();
-        if (!req.voice.empty() && qt_n_speakers(q) > 0) {
+
+        auto preset_it = req.voice.empty() ? presets.end() : presets.find(req.voice);
+        if (preset_it != presets.end()) {
+            // Preset clone path: pre-encoded speaker embedding (+ optional ICL
+            // reference codes/transcript), never re-reads a reference file.
+            p.ref_spk_emb = preset_it->second.spk_emb.data();
+            p.ref_spk_dim = (int) preset_it->second.spk_emb.size();
+            if (!preset_it->second.codes.empty()) {
+                p.ref_codes = preset_it->second.codes.data();
+                p.ref_T     = preset_it->second.ref_T;
+                p.ref_text  = preset_it->second.ref_text.c_str();
+            }
+        } else if (!req.voice.empty() && qt_n_speakers(q) > 0) {
             p.speaker = req.voice.c_str();
         }
         if (!req.instructions.empty()) {
