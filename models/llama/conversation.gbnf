# JPLearn Tutor conversation grammar
# Goal: keep responses in a short conversational shape (1-3 sentences),
# single paragraph, and avoid long off-script blocks.

root ::= one | two | three
one ::= sentence
two ::= sentence sep sentence
three ::= sentence sep sentence sep sentence

# Allow optional spacing between sentence boundaries.
sep ::= "" | " "

sentence ::= chunk terminal
chunk ::= char | char chunk

# Any non-newline, non-terminal character.
char ::= [^\n.!?。！？]
terminal ::= "." | "!" | "?" | "。" | "！" | "？"
