{
  "name": "electron-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "JPLearn desktop frontend built with Electron, React, and TypeScript.",
  "author": "Robbie",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "build": "tsc -b && vite build",
    "build:quiet": "tsc -b && vite build --logLevel error",
    "start": "electron .",
    "forge:start": "npm run build && electron-forge start",
    "lint": "oxlint",
    "session:recover": "powershell -ExecutionPolicy Bypass -File ./scripts/session-recover.ps1",
    "session:check": "powershell -ExecutionPolicy Bypass -File ./scripts/session-recover.ps1 -SkipInstall -RunChecks",
    "test:ui": "vitest run",
    "preview": "vite preview",
    "package": "npm run build && electron-forge package",
    "smoke:packaged": "node ./scripts/packaged-smoke.cjs",
    "make": "npm run build && electron-forge make",
    "make:win": "npm run build && electron-forge make --platform=win32"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/klee-one": "^5.2.8",
    "@fontsource/m-plus-rounded-1c": "^5.2.10",
    "@fontsource/zen-kaku-gothic-new": "^5.2.7",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.5.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.10"
  }
}
