{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".github/copilot-instructions.md",
    ".github/instructions/data.instructions.md",
    ".github/instructions/domain.instructions.md",
    ".github/instructions/electron.instructions.md",
    "C:/Users/Robbie/.config/opencode/plugin/shell-strategy/shell_strategy.md"
  ],
  "command": {
    "test": { "description": "Run pytest with optional path filter", "template": "python -m pytest $ARGUMENTS -q" },
    "dev": { "description": "Start full dev environment (Electron + Vite)", "template": "cd electron-frontend && npm run dev" },
    "lint": { "description": "Run oxlint on electron-frontend", "template": "cd electron-frontend && npm run lint" },
    "check": { "description": "Run full aggregate check (arch + lint + test)", "template": "python scripts/dev.py" },
    "arch": { "description": "Run architecture boundary check", "template": "python scripts/arch_check.py" },
    "build": { "description": "Build electron-frontend (tsc + vite)", "template": "cd electron-frontend && npm run build" },
    "run": { "description": "Build and start the Electron app", "template": "cd electron-frontend && npm run build && npm run start" }
  },
  "model": "deepseek/deepseek-v4-pro",
  "provider": {
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "options": {
            "reasoning_effort": "max"
          }
        }
      }
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp",
    "opencode-handoff",
    "open-mem",
    "opencode-smart-title",
    "cc-safety-net",
    "opencode-snip",
    "envsitter-guard",
    "micode"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "exa-search": {
      "type": "local",
      "command": ["npx", "-y", "exa-mcp-server"],
      "enabled": true,
      "env": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      }
    },
    "lsp": {
      "type": "local",
      "command": ["C:/Users/Robbie/go/bin/mcp-language-server", "--workspace", "C:/Users/Robbie/Documents/Projects/JPLearn", "--lsp", "C:/Users/Robbie/Documents/Projects/JPLearn/.venv/Scripts/pyright-langserver.exe", "--", "--stdio"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "X-API-Key": "{env:CONTEXT7_API_KEY}"
      }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "@bytebase/dbhub@latest", "--transport", "stdio", "--dsn", "sqlite:///C:/Users/Robbie/Documents/Projects/JPLearn/data/jplearn.db"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "python -m pytest *": "allow",
      "python scripts/arch_check.py": "allow",
      "python scripts/dev.py": "allow",
      "python scripts/debug_tools.py *": "allow",
      "npm run *": "allow"
    },
    "external_directory": {
      "*": "ask",
      "C:\\Users\\Robbie\\Documents\\Projects\\JPLearn\\**": "allow",
      "~/.config/opencode/**": "allow"
    }
  }
}
