{
  "name": "electron-frontend",
  "private": true,
  "version": "0.1.0-beta",
  "productName": "JPLearn",
  "description": "JPLearn desktop frontend built with Electron, React, and TypeScript.",
  "author": "Robbie",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "build": "tsc -b && vite build",
    "build:quiet": "tsc -b && vite build --logLevel error",
    "start": "electron .",
    "forge:start": "npm run build && electron-forge start",
    "lint": "oxlint",
    "session:recover": "powershell -ExecutionPolicy Bypass -File ./scripts/session-recover.ps1",
    "session:check": "powershell -ExecutionPolicy Bypass -File ./scripts/session-recover.ps1 -SkipInstall -RunChecks",
    "test:ui": "vitest run",
    "test:a11y": "vitest run src/App.accessibility.test.tsx",
    "verify:handwriting-assets": "node ./scripts/verify-handwriting-assets.cjs",
    "preview": "vite preview",
    "package": "npm run build && electron-forge package",
    "test:e2e": "npm run build:quiet && vitest run --config vitest.e2e.config.ts",
    "smoke:packaged": "node ./scripts/packaged-smoke.cjs",
    "make": "npm run build && electron-forge make",
    "make:win": "npm run build && electron-forge make --platform=win32",
    "bundle:python": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/bundle_python.ps1",
    "make:release": "npm run bundle:python && cross-env JPLEARN_DOCUMENTS_DIR=$TEMP/jplearn-build-data npm run make:win"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-collapsible": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "electron-store": "^11.0.2",
    "embla-carousel-react": "^8.6.0",
    "hanzi-writer": "3.6.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.21.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "^19.2.7",
    "react-type-animation": "^3.2.0",
    "unofficial-jisho-api": "^2.3.4",
    "update-electron-app": "^3.3.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@testing-library/react": "^16.3.0",
    "@types/culori": "^4.0.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.12.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.5.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.10"
  }
}
