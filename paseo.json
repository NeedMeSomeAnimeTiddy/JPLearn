{
  "worktree": {
    "setup": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
    "teardown": []
  },
  "scripts": {
    "ui-lint": {
      "command": "cmd.exe /d /c \"cd /d electron-frontend && npm run lint\""
    },
    "ui-tests": {
      "command": "cmd.exe /d /c \"cd /d electron-frontend && npm run test:ui\""
    },
    "ui-build": {
      "command": "cmd.exe /d /c \"cd /d electron-frontend && npm run build\""
    },
    "python-dependencies": {
      "command": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
    },
    "python-tests": {
      "command": "cmd.exe /d /c \".venv\\Scripts\\python.exe -m pytest -q\""
    },
    "start-app": {
      "command": "cmd.exe /d /c \"cd /d electron-frontend && npm.cmd run start\""
    },
    "ui-a11y": {
      "command": "cmd.exe /d /c \"cd /d electron-frontend && npm.cmd run test:a11y\""
    },
    "architecture": {
      "command": "cmd.exe /d /c \".venv\\Scripts\\python.exe scripts/arch_check.py\""
    },
    "type-generation": {
      "command": "cmd.exe /d /c \".venv\\Scripts\\python.exe scripts/generate_ts_types.py --check\""
    }
  },
  "metadataGeneration": {
    "title": {
      "instructions": "Name the task in JPLearn using 2-6 plain words. Describe the specific work, without a generic project prefix."
    },
    "branchName": {
      "instructions": "Use a short lowercase branch name with feat/, fix/, docs/, chore/ or art/ matching the actual task. Follow any more specific repository branch convention."
    },
    "commitMessage": {
      "instructions": "Lead with a concise, concrete subject describing the change. Follow repository instructions and existing commit style. When a body is useful, explain the reason and only checks actually observed; distinguish remaining gaps. Do not claim approvals, test success or publication without evidence."
    },
    "pullRequest": {
      "instructions": "Explain the concrete problem and resulting behavior in plain words. Include Validation with observed checks and unverified gaps. Follow any repository PR template and keep scope and asset approval status accurate."
    }
  }
}
